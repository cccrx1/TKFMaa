+using MFAAvalonia.Extensions.MaaFW;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Text.RegularExpressions;
+using Option = MFAAvalonia.Extensions.MaaFW.MaaInterface.MaaInterfaceOption;
+using Case = MFAAvalonia.Extensions.MaaFW.MaaInterface.MaaInterfaceOptionCase;
+using Selection = MFAAvalonia.Extensions.MaaFW.MaaInterface.MaaInterfaceSelectOption;
+
+namespace MFAAvalonia.Helper;
+
+internal static class TkfmStaminaCatalog
+{
+    public const string Entry = "DailyStaminaStart";
+    private const string ProjectName = "TKFMaa";
+    private const string ActivityOptionPrefix = "体力消耗关卡@";
+    private const string LocalPrefix = "tkfm-local-stamina:";
+    private const string StagePrefix = LocalPrefix + "stages:";
+    private const string SelectedId = "tkfm_stamina_case";
+    private const string LegacyCase = "自定义关卡";
+    private const string TemplateOption = "自定义体力关卡模板";
+    private const string SectionOption = "自定义体力活动分区";
+    private const string ColumnOption = "自定义体力复刻地图区域";
+    private static string CatalogPath => Path.Combine(AppPaths.ConfigDirectory, "stamina-activities.json");
+
+    public static readonly string[] Templates = ["普通列表活动", "常规分页活动", "复刻地图活动"];
+    public static readonly string[] Sections = ["限时活动", "目前活动"];
+    public static readonly string[] Columns = ["中路", "左路", "右路"];
+
+    internal sealed record Stage(Guid Id, string Name, int Cost);
+    internal sealed record Activity(Guid Id, string Name, string Template, string Section, string Marker,
+        string Column, List<Stage> Stages)
+    {
+        [JsonIgnore]
+        public string CaseId => LocalPrefix + Id.ToString("N");
+    }
+
+    public static event EventHandler? Changed;
+
+    public static bool IsActivityOption(string? name) => name?.StartsWith(ActivityOptionPrefix, StringComparison.Ordinal) == true;
+    public static bool IsLocalCase(string? name) => name?.StartsWith(LocalPrefix, StringComparison.Ordinal) == true;
+
+    public static string? GetId(Selection option) =>
+        (IsActivityOption(option.Name) || option.Name?.StartsWith(StagePrefix, StringComparison.Ordinal) == true)
+        && option.Data?.GetValueOrDefault(SelectedId) is { } id ? id : null;
+
+    public static void Select(Selection option, string? caseName, int index)
+    {
+        if (IsLocalCase(caseName) &&
+            (IsActivityOption(option.Name) || option.Name?.StartsWith(StagePrefix, StringComparison.Ordinal) == true))
+        {
+            option.Data ??= new();
+            option.Data[SelectedId] = caseName;
+            option.Index = -1;
+            return;
+        }
+        if (GetId(option) != null)
+            option.Data!.Remove(SelectedId);
+        option.Index = index;
+    }
+
+    public static int GetIndex(Selection option, Option definition) =>
+        GetId(option) is { } id ? definition.Cases?.FindIndex(item => item.Name == id) ?? -1 : option.Index ?? -1;
+
+    public static void StabilizeStage(Selection option, Option definition)
+    {
+        if (option.Name?.StartsWith(StagePrefix, StringComparison.Ordinal) == true &&
+            GetId(option) == null && definition.Cases is { Count: > 0 } cases)
+            Select(option, cases[0].Name, 0);
+    }
+
+    public static Dictionary<string, JToken> MissingSelectionOverride() => new()
+    {
+        [Entry] = JObject.FromObject(new
+        {
+            action = new
+            {
+                type = "Custom",
+                param = new
+                {
+                    custom_action = "DailyStaminaConfigureCustom",
+                    custom_action_param = new { enabled = true, local_selection_missing = true }
+                }
+            }
+        })
+    };
+
+    public static bool IsSupported(MaaInterface? project) => FindSelector(project) != null;
+
+    private static Option? FindSelector(MaaInterface? project)
+    {
+        if (project?.Name != ProjectName || project.Option == null)
+            return null;
+        var selectorName = project.Task?.FirstOrDefault(task => task.Entry == Entry)?.Option?
+            .FirstOrDefault(option => IsActivityOption(option.Name))?.Name;
+        return selectorName != null && project.Option.TryGetValue(selectorName, out var selector) &&
+            selector.Cases?.Count(item => item.Name == LegacyCase && item.PipelineOverride != null) == 1 &&
+            project.Option.ContainsKey(TemplateOption) && project.Option.ContainsKey(SectionOption) &&
+            project.Option.ContainsKey(ColumnOption) ? selector : null;
+    }
+
+    public static void Load(MaaInterface project)
+    {
+        if (FindSelector(project) is not { } selector)
+            return;
+        try
+        {
+            Apply(project, selector, BuildOverlay(project, selector, Read()));
+        }
+        catch (Exception ex) when (ex is IOException or InvalidDataException or UnauthorizedAccessException or JsonException)
+        {
+            LoggerHelper.Warning($"读取本地体力活动失败：{ex.Message}");
+        }
+    }
+
+    public static List<Activity> Read()
+    {
+        if (!File.Exists(CatalogPath))
+            return [];
+        var activities = JsonConvert.DeserializeObject<List<Activity>>(File.ReadAllText(CatalogPath))
+            ?? throw new InvalidDataException("活动配置为空。");
+        foreach (var activity in activities)
+            Validate(activity);
+        if (activities.Select(item => item.Id).Distinct().Count() != activities.Count ||
+            activities.Select(item => item.Name).Distinct(StringComparer.Ordinal).Count() != activities.Count)
+            throw new InvalidDataException("活动配置包含重复记录。");
+        return activities;
+    }
+
+    public static void Save(MaaInterface project, Activity activity, Activity? original)
+    {
+        Validate(activity);
+        var selector = FindSelector(project) ?? throw new InvalidDataException("当前资源包不支持自定义活动。");
+        Directory.CreateDirectory(AppPaths.ConfigDirectory);
+        using var fileLock = File.Open(CatalogPath + ".lock", FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
+        var activities = Read();
+        var index = activities.FindIndex(item => item.Id == activity.Id);
+        if (original != null && (index < 0 || !JToken.DeepEquals(JToken.FromObject(activities[index]), JToken.FromObject(original))))
+            throw new InvalidDataException("此活动已在其他窗口修改，请重新打开弹窗。");
+        if (activities.Any(item => item.Id != activity.Id && item.Name == activity.Name))
+            throw new InvalidDataException("已存在同名自定义活动。");
+        if (index < 0)
+            activities.Add(activity);
+        else
+            activities[index] = activity;
+
+        var overlay = BuildOverlay(project, selector, activities);
+        var temporary = CatalogPath + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        try
+        {
+            File.WriteAllText(temporary, JsonConvert.SerializeObject(activities, Formatting.Indented));
+            File.Move(temporary, CatalogPath, overwrite: true);
+        }
+        finally
+        {
+            File.Delete(temporary);
+        }
+        Apply(project, selector, overlay);
+    }
+
+    public static void NotifyChanged() => Changed?.Invoke(null, EventArgs.Empty);
+
+    private static void Validate(Activity? activity)
+    {
+        if (activity == null || activity.Id == Guid.Empty || string.IsNullOrWhiteSpace(activity.Name) ||
+            !Templates.Contains(activity.Template) || !Sections.Contains(activity.Section) || !Columns.Contains(activity.Column) ||
+            activity.Marker == null || activity.Stages is not { Count: > 0 })
+            throw new InvalidDataException("请完整填写活动信息并至少添加一个关卡。");
+        if (Regex.IsMatch(activity.Name, "协会共斗|協會共鬥|挑战活动|挑戰活動|活动挑战|活動挑戰"))
+            throw new InvalidDataException("请填写活动本体名称。");
+        if (activity.Stages.Any(stage => stage == null || stage.Id == Guid.Empty ||
+            string.IsNullOrWhiteSpace(stage.Name) || stage.Cost <= 0))
+            throw new InvalidDataException("每个关卡都需要名称和正整数体力消耗。");
+        if (activity.Stages.Select(stage => stage.Id).Distinct().Count() != activity.Stages.Count ||
+            activity.Stages.Select(stage => stage.Name).Distinct(StringComparer.Ordinal).Count() != activity.Stages.Count)
+            throw new InvalidDataException("同一活动内的关卡名称不能重复。");
+    }
+
+    private static (List<Case> Cases, Dictionary<string, Option> Stages) BuildOverlay(
+        MaaInterface project, Option selector, List<Activity> activities)
+    {
+        var options = project.Option!;
+        var builtIns = selector.Cases!.Where(item => !IsLocalCase(item.Name)).ToList();
+        var legacy = builtIns.Single(item => item.Name == LegacyCase);
+        var generated = new Dictionary<string, Option>();
+        foreach (var activity in activities)
+        {
+            var stageOptionName = StagePrefix + activity.Id.ToString("N");
+            var stages = activity.Stages.Select(stage => new Case
+            {
+                Name = LocalPrefix + stage.Id.ToString("N"),
+                Label = stage.Name,
+                DisplayName = stage.Name,
+                PipelineOverride = BuildOverride(options, legacy, activity, stage)
+            }).ToList();
+            generated.Add(stageOptionName, new Option
+            {
+                Name = stageOptionName, Label = "关卡", Type = "select", Cases = stages
+            });
+            var label = builtIns.Any(item => (item.Label ?? item.Name) == activity.Name)
+                ? $"{activity.Name}（自定义）" : activity.Name;
+            builtIns.Add(new Case { Name = activity.CaseId, Label = label, DisplayName = label, Option = [stageOptionName] });
+        }
+
+        return (builtIns, generated);
+    }
+
+    private static void Apply(MaaInterface project, Option selector, (List<Case> Cases, Dictionary<string, Option> Stages) overlay)
+    {
+        var options = project.Option!;
+        foreach (var key in options.Keys.Where(key => key.StartsWith(StagePrefix, StringComparison.Ordinal)).ToList())
+            options.Remove(key);
+        foreach (var (key, value) in overlay.Stages)
+            options.Add(key, value);
+        selector.Cases = overlay.Cases;
+    }
+
+    private static Dictionary<string, JToken> BuildOverride(Dictionary<string, Option> options, Case legacy,
+        Activity activity, Stage stage)
+    {
+        var result = JObject.FromObject(legacy.PipelineOverride!);
+        foreach (var (option, name) in new[] { (TemplateOption, activity.Template), (SectionOption, activity.Section),
+                     (ColumnOption, activity.Column) })
+        {
+            if (option == ColumnOption && activity.Template != Templates[2])
+                continue;
+            var patch = options[option].Cases?.FirstOrDefault(item => item.Name == name)?.PipelineOverride
+                ?? throw new InvalidDataException($"资源包缺少活动配置选项：{name}。");
+            result.Merge(JObject.FromObject(patch), new JsonMergeSettings { MergeArrayHandling = MergeArrayHandling.Replace });
+        }
+        result["DailyStaminaCustomInput"] = JObject.FromObject(new
+        {
+            attach = new { activity = activity.Name, stage = stage.Name, list_marker = activity.Marker, cost = stage.Cost }
+        });
+        return result.ToObject<Dictionary<string, JToken>>()!;
+    }
+}
