+using Avalonia;
+using Avalonia.Controls;
+using Avalonia.Layout;
+using Avalonia.Media;
+using MFAAvalonia.Extensions.MaaFW;
+using Newtonsoft.Json;
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using Activity = MFAAvalonia.Helper.TkfmStaminaCatalog.Activity;
+using Stage = MFAAvalonia.Helper.TkfmStaminaCatalog.Stage;
+
+namespace MFAAvalonia.Helper;
+
+internal sealed class TkfmStaminaEditor : Window
+{
+    private readonly List<StageRow> _stages = [];
+    private readonly StackPanel _stageRows = new() { Spacing = 8 };
+    private sealed record StageRow(Guid Id, TextBox Name, TextBox Cost, Grid Control);
+
+    public TkfmStaminaEditor(MaaInterface project, Activity? original)
+    {
+        Title = original == null ? "添加活动" : "编辑活动";
+        Width = 560;
+        Height = 610;
+        MinWidth = 390;
+        MinHeight = 420;
+        WindowStartupLocation = WindowStartupLocation.CenterOwner;
+
+        var name = new TextBox { Text = original?.Name, Watermark = "游戏活动卡上的完整标题" };
+        var template = Choices(TkfmStaminaCatalog.Templates, original?.Template);
+        var section = Choices(TkfmStaminaCatalog.Sections, original?.Section);
+        var marker = new TextBox { Text = original?.Marker, Watermark = "留空时使用活动名称" };
+        var column = Choices(TkfmStaminaCatalog.Columns, original?.Column);
+        var columnField = Field("地图搜索区域", column);
+        columnField.IsVisible = template.SelectedIndex == 2;
+        template.SelectionChanged += (_, _) => columnField.IsVisible = template.SelectedIndex == 2;
+
+        var addStage = new Button { Content = "添加关卡" };
+        addStage.Click += (_, _) => AddStage(null).Name.Focus();
+        foreach (var stage in original?.Stages ?? [])
+            AddStage(stage);
+        if (_stages.Count == 0)
+            AddStage(null);
+
+        var error = new TextBlock { Foreground = Brushes.IndianRed, TextWrapping = TextWrapping.Wrap };
+        var cancel = new Button { Content = "取消", IsCancel = true };
+        cancel.Click += (_, _) => Close();
+        var save = new Button { Content = "保存活动" };
+        save.Click += (_, _) =>
+        {
+            try
+            {
+                var stages = _stages.Select(row =>
+                {
+                    if (!int.TryParse(row.Cost.Text?.Trim(), NumberStyles.None, CultureInfo.InvariantCulture, out var cost) || cost <= 0)
+                        throw new InvalidDataException("每个关卡的体力消耗都必须为正整数。");
+                    return new Stage(row.Id, row.Name.Text?.Trim() ?? "", cost);
+                }).ToList();
+                var activity = new Activity(original?.Id ?? Guid.NewGuid(), name.Text?.Trim() ?? "",
+                    (string)template.SelectedItem!, (string)section.SelectedItem!, marker.Text?.Trim() ?? "",
+                    (string)column.SelectedItem!, stages);
+                if (!ReferenceEquals(project, MaaProcessor.Interface) || !Instances.RootViewModel.Idle)
+                    throw new InvalidDataException("客户端状态已变化，请关闭弹窗后重试。");
+                TkfmStaminaCatalog.Save(project, activity, original);
+                Close(activity);
+            }
+            catch (Exception ex) when (ex is IOException or InvalidDataException or UnauthorizedAccessException or JsonException)
+            {
+                error.Text = ex.Message;
+            }
+        };
+
+        var buttons = new StackPanel
+        {
+            Orientation = Orientation.Horizontal, HorizontalAlignment = HorizontalAlignment.Right,
+            Spacing = 8, Children = { cancel, save }
+        };
+        var footer = new StackPanel { Spacing = 8, Margin = new Thickness(20, 10, 20, 16), Children = { error, buttons } };
+        var form = new StackPanel
+        {
+            Margin = new Thickness(20, 16), Spacing = 10,
+            Children =
+            {
+                Field("活动名称", name), Field("活动类型", template), Field("活动分区", section),
+                Field("列表或地图标题（可选）", marker), columnField,
+                new TextBlock { Text = "关卡", FontWeight = FontWeight.SemiBold, Margin = new Thickness(0, 8, 0, 0) },
+                _stageRows, addStage
+            }
+        };
+        var scroll = new ScrollViewer { Content = form };
+        DockPanel.SetDock(footer, Dock.Bottom);
+        Content = new DockPanel { Children = { footer, scroll } };
+        Opened += (_, _) => name.Focus();
+    }
+
+    private StageRow AddStage(Stage? stage)
+    {
+        var name = new TextBox { Text = stage?.Name, Watermark = "完整关卡名称" };
+        var cost = new TextBox { Text = stage?.Cost.ToString(CultureInfo.InvariantCulture) ?? "30", Watermark = "体力" };
+        var remove = new Button { Content = "移除", VerticalAlignment = VerticalAlignment.Bottom };
+        var nameField = Field("关卡名称", name);
+        var costField = Field("每次体力", cost);
+        var grid = new Grid { ColumnDefinitions = new ColumnDefinitions("*,8,84,8,Auto") };
+        Grid.SetColumn(costField, 2);
+        Grid.SetColumn(remove, 4);
+        grid.Children.Add(nameField);
+        grid.Children.Add(costField);
+        grid.Children.Add(remove);
+        var row = new StageRow(stage?.Id ?? Guid.NewGuid(), name, cost, grid);
+        _stages.Add(row);
+        _stageRows.Children.Add(grid);
+
+        remove.Click += (_, _) =>
+        {
+            _stageRows.Children.Remove(row.Control);
+            _stages.Remove(row);
+            if (_stages.Count == 0)
+                AddStage(null).Name.Focus();
+        };
+        return row;
+    }
+
+    private static ComboBox Choices(string[] choices, string? selected) => new()
+    {
+        ItemsSource = choices, SelectedIndex = Math.Max(0, Array.IndexOf(choices, selected)),
+        HorizontalAlignment = HorizontalAlignment.Stretch
+    };
+
+    private static StackPanel Field(string label, Control input) => new()
+    {
+        Spacing = 4, Children = { new TextBlock { Text = label }, input }
+    };
+}
