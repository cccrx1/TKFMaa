+using System;
+using System.IO;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+
+namespace MFAAvalonia.Helper;
+
+// Candidate for the pinned MFAAvalonia 2.16.2 build. Requires compilation and UI acceptance.
+internal static class TkfmPackagePreflight
+{
+    internal static void Validate(string root, string interfacePath)
+    {
+        var project = JObject.Parse(File.ReadAllText(interfacePath));
+        if (!string.Equals(project["name"]?.ToString(), "TKFMaa", StringComparison.Ordinal))
+            return;
+
+        RequireFile(root, "agent/main.py");
+        CheckTemplates(root, project, "interface.json");
+        var pipeline = Path.Combine(root, "resource", "pipeline");
+        if (!Directory.Exists(pipeline))
+            throw new InvalidDataException("TKFMaa package is missing resource/pipeline");
+        foreach (var file in Directory.EnumerateFiles(pipeline, "*", SearchOption.AllDirectories)
+                     .Where(file => Path.GetExtension(file) is ".json" or ".jsonc"))
+            CheckTemplates(root, JObject.Parse(File.ReadAllText(file)), Path.GetRelativePath(root, file));
+    }
+
+    private static string ResolveInside(string root, string relative)
+    {
+        if (string.IsNullOrWhiteSpace(relative) || Path.IsPathRooted(relative)
+            || relative.Contains(':') || relative.Contains('\\')
+            || relative.Split('/').Contains(".."))
+            throw new InvalidDataException($"Unsafe TKFMaa package reference: {relative}");
+        var prefix = Path.GetFullPath(root).TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;
+        var full = Path.GetFullPath(Path.Combine(root, relative));
+        if (!full.StartsWith(prefix, StringComparison.Ordinal)
+            && !full.Equals(prefix.TrimEnd(Path.DirectorySeparatorChar), StringComparison.Ordinal))
+            throw new InvalidDataException($"TKFMaa package reference escapes root: {relative}");
+        return full;
+    }
+
+    private static void RequireFile(string root, string relative)
+    {
+        if (!File.Exists(ResolveInside(root, relative)))
+            throw new InvalidDataException($"TKFMaa package file missing: {relative}");
+    }
+
+    private static void CheckTemplates(string root, JToken value, string source)
+    {
+        if (value is JObject obj)
+        {
+            foreach (var property in obj.Properties())
+            {
+                if (property.Name == "template")
+                {
+                    var references = property.Value is JArray array ? array.ToArray() : new[] { property.Value };
+                    foreach (var reference in references)
+                    {
+                        if (reference.Type != JTokenType.String)
+                            throw new InvalidDataException($"Invalid template reference in {source}");
+                        var template = reference.Value<string>()!;
+                        // Validate before prefixing so absolute paths are rejected on every platform.
+                        ResolveInside(Path.Combine(root, "resource", "image"), template);
+                        var path = ResolveInside(root, "resource/image/" + template);
+                        if (!File.Exists(path) && !(Directory.Exists(path)
+                            && Directory.EnumerateFiles(path, "*", SearchOption.AllDirectories).Any(IsImage)))
+                            throw new InvalidDataException($"Missing template {template} referenced by {source}");
+                    }
+                }
+                CheckTemplates(root, property.Value, source);
+            }
+        }
+        else if (value is JArray array)
+            foreach (var child in array)
+                CheckTemplates(root, child, source);
+    }
+
+    private static bool IsImage(string file) => Path.GetExtension(file).ToLowerInvariant()
+        is ".png" or ".jpg" or ".jpeg" or ".webp" or ".bmp";
+}
