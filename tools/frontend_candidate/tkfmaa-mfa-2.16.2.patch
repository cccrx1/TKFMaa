+using System;
+using System.IO;
+using Newtonsoft.Json.Linq;
+
+namespace MFAAvalonia.Helper;
+
+public static class TkfmRuntimeEnvironment
+{
+    public static bool UseTcpAgent { get; private set; }
+
+    // Configure before loading Maa native libraries: ZeroMQ's internal signaler
+    // also uses TMP, independently of MaaAgent's public IPC endpoint.
+    public static void Prepare(string root)
+    {
+        if (!OperatingSystem.IsWindows()) return;
+        var interfacePath = Path.Combine(root, "interface.json");
+        if (!File.Exists(interfacePath)) return;
+        JObject definition;
+        try { definition = JObject.Parse(File.ReadAllText(interfacePath)); }
+        catch (Newtonsoft.Json.JsonException) { return; }
+        if (!string.Equals(definition["name"]?.ToString(), "TKFMaa", StringComparison.Ordinal)) return;
+
+        var directory = Path.GetFullPath(Path.Combine(root, "logs", "runtime-temp"));
+        Directory.CreateDirectory(directory);
+        var probe = Path.Combine(directory, $"write-probe-{Guid.NewGuid():N}");
+        using (new FileStream(probe, FileMode.CreateNew, FileAccess.Write, FileShare.None,
+                   1, FileOptions.DeleteOnClose)) { }
+        Environment.SetEnvironmentVariable("TEMP", directory);
+        Environment.SetEnvironmentVariable("TMP", directory);
+        UseTcpAgent = true;
+    }
+}
