{
    "__CommonMainExpeditionButton": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    450,
                    820,
                    230,
                    160
                ],
                "expected": [
                    "出征"
                ]
            }
        }
    },
    "__CommonMainTrainingButton": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    570,
                    1000,
                    120,
                    110
                ],
                "expected": [
                    "调教"
                ]
            }
        }
    },
    "CommonMainReady": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__CommonMainExpeditionButton",
                    "__CommonMainTrainingButton"
                ]
            }
        }
    },
    "CommonStopOnMain": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady"
                ]
            }
        },
        "action": {
            "type": "StopTask"
        }
    },
    "CommonStopOnMainWithRetries": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMainObserve",
            "CommonStopOnMainWait1"
        ],
        "timeout": 10000
    },
    "CommonStopOnMainWait1": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMainObserve",
            "CommonStopOnMainWait2"
        ],
        "timeout": 10000,
        "post_delay": 300
    },
    "CommonStopOnMainWait2": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMainObserve",
            "CommonStopOnMainWait3"
        ],
        "timeout": 10000,
        "post_delay": 300
    },
    "CommonStopOnMainWait3": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMainObserve"
        ],
        "timeout": 10000,
        "post_delay": 300
    },
    "CommonStopOnMainObserve": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "CommonMainReady"
                ]
            }
        },
        "next": [
            "CommonStopOnMainConfirm"
        ],
        "post_delay": 1000
    },
    "CommonStopOnMainConfirm": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMain"
        ],
        "timeout": 10000
    },
    "CommonWaitLoading": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    "__CommonLoadingText",
                    "__CommonLoadingStatusLine"
                ]
            }
        },
        "post_delay": 500
    },
    "__CommonLoadingText": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "[Ll]\\s*[Oo0]\\s*[Aa]\\s*[Dd]",
                    "[Cc]?\\s*[Oo0]\\s*[Nn]\\s*[Nn]?\\s*[Ee]\\s*[CcGg]"
                ],
                "roi": [
                    180,
                    1158,
                    360,
                    92
                ]
            }
        }
    },
    "__CommonLoadingStatusLine": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    198,
                    1207,
                    325,
                    34
                ],
                "only_rec": true,
                "threshold": 0.65,
                "expected": [
                    "^\\s*[Ll]\\s*[Oo0]\\s*[Aa]\\s*[Dd]\\s*[Ii1l]\\s*[Nn]\\s*[Gg]\\s*$",
                    "^\\s*[Cc]\\s*[Oo0]\\s*[Nn]\\s*[Nn]\\s*[Ee]\\s*[Cc]\\s*[Tt]\\s*[Ii1l]\\s*[Nn]\\s*[Gg]\\s*$"
                ]
            }
        }
    },
    "CommonCloseReward": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    300,
                    700,
                    120,
                    80
                ],
                "expected": [
                    "确定",
                    "确认"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                300,
                700,
                120,
                80
            ],
            "timeout": 1500
        }
    },
    "__CommonGiftTabs": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    100,
                    95,
                    530,
                    75
                ],
                "expected": [
                    "^限时$",
                    "^精选$",
                    "^月卡$",
                    "^STEP$"
                ]
            }
        }
    },
    "CommonCloseMainGift": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__CommonGiftTabs"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    40,
                    75
                ]
            }
        },
        "pre_wait_freezes": 300,
        "max_hit": 3
    }
}
