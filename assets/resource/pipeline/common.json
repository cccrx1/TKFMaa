{
    "__CommonMainExpeditionButton": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    450,
                    820,
                    230,
                    160
                ],
                "expected": [
                    "出征"
                ]
            }
        }
    },
    "__CommonMainTrainingButton": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    570,
                    1000,
                    120,
                    110
                ],
                "expected": [
                    "调教"
                ]
            }
        }
    },
    "CommonMainReady": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__CommonMainExpeditionButton",
                    "__CommonMainTrainingButton"
                ]
            }
        }
    },
    "CommonStopOnMain": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__CommonMainExpeditionButton",
                    "__CommonMainTrainingButton"
                ]
            }
        },
        "action": {
            "type": "StopTask"
        }
    },
    "CommonStopOnMainWithRetries": {
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMain",
            "CommonStopOnMainWait1"
        ],
        "timeout": 10000
    },
    "CommonStopOnMainWait1": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMain",
            "CommonStopOnMainWait2"
        ],
        "timeout": 10000,
        "post_delay": 300
    },
    "CommonStopOnMainWait2": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMain",
            "CommonStopOnMainWait3"
        ],
        "timeout": 10000,
        "post_delay": 300
    },
    "CommonStopOnMainWait3": {
        "recognition": {
            "type": "DirectHit"
        },
        "next": [
            "[JumpBack]CommonWaitLoading",
            "[JumpBack]CommonCloseMainGift",
            "CommonStopOnMain"
        ],
        "timeout": 10000,
        "post_delay": 300
    },
    "CommonWaitLoading": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "L\\s*O\\s*A\\s*D\\s*I\\s*N\\s*G",
                    "C\\s*O\\s*N\\s*N\\s*E\\s*C\\s*T\\s*I\\s*N\\s*G"
                ],
                "roi": [
                    180,
                    1158,
                    360,
                    92
                ]
            }
        },
        "post_delay": 500
    },
    "CommonCloseReward": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    300,
                    700,
                    120,
                    80
                ],
                "expected": [
                    "确定",
                    "确认"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_wait_freezes": {
            "time": 500,
            "target": [
                0,
                0,
                0,
                0
            ]
        },
        "pre_wait_freezes": 300
    },
    "__CommonGiftTabs": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    100,
                    95,
                    530,
                    75
                ],
                "expected": [
                    "^限时$",
                    "^精选$",
                    "^月卡$",
                    "^STEP$"
                ]
            }
        }
    },
    "CommonCloseMainGift": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "__CommonGiftTabs"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    40,
                    75
                ]
            }
        },
        "pre_wait_freezes": 300,
        "max_hit": 3
    }
}
